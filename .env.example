# .env.example
# Copy this file to .env.local and fill in your actual Supabase credentials
# Never commit .env.local - it contains your real secrets!

# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

# Supabase project URL (format: https://YOUR-PROJECT-REF.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe for client-side usage)
# This key is used for RLS-protected operations
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SECURITY NOTE:
# - DO NOT put your service role key here or in any frontend .env file
# - The anon key is safe for client-side use (it respects RLS policies)
# - Never commit .env.local or any file containing real credentials

